# VORTEX Frontend Environment Variables
# ==================================
#
# MapLibre style URL — required for the map to render.
# Set this to your production style URL before deployment.
# For local development you can use the demotiles style:
#
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
#
# Backend API base URL
#
VITE_API_BASE_URL=http://localhost:8000